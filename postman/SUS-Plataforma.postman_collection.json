    {
      "name": "8. Testes de seguranca",
      "description": "Demonstra o Artigo IV da constituicao: negar por padrao, autorizacao por perfil e posse do dado.",
      "item": [
        {
          "name": "Sem token deve responder 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('erro em problem+json', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('problem+json'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/usuarios", "host": ["{{baseUrl}}"], "path": ["api", "v1", "usuarios"] }
          }
        },
        {
          "name": "Login como paciente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('tokenPaciente', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailPaciente}}\",\n  \"senha\": \"{{senhaPaciente}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
          }
        },
        {
          "name": "Paciente listando usuarios deve responder 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenPaciente}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/usuarios", "host": ["{{baseUrl}}"], "path": ["api", "v1", "usuarios"] },
            "description": "Perfil sem permissao: a listagem de usuarios exige ADMINISTRADOR."
          }
        },
        {
          "name": "Paciente lendo cadastro de terceiro deve responder 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found, nao 403', () => pm.response.to.have.status(404));",
                  "pm.test('nao revela a existencia do registro alheio', () => {",
                  "    pm.expect(pm.response.text()).to.not.include('cartaoSus');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenPaciente}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/pacientes/11111111-1111-1111-1111-111111111111",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "pacientes", "11111111-1111-1111-1111-111111111111"]
            },
            "description": "Artigo IV.7: recurso de terceiro responde 404, para nao revelar que ele existe."
          }
        },
        {
          "name": "Paciente consultando o proprio cadastro",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('e o proprio cadastro', () => {",
                  "    pm.expect(pm.response.json().usuarioId).to.eql(pm.collectionVariables.get('usuarioPacienteId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenPaciente}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/pacientes/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "pacientes", "me"] }
          }
        }
      ]
    }
  ]
}
