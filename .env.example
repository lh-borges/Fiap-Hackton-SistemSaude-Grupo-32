# Copie para .env e ajuste. Nunca versione o .env.
DB_NAME=sus
DB_USER=sus
DB_PASSWORD=sus
DB_PORT=5432

APP_PORT=8080
SPRING_PROFILES_ACTIVE=docker

# Minimo de 32 caracteres (HS256). Troque em qualquer ambiente que nao seja local.
JWT_SECRET=troque-este-segredo-de-desenvolvimento-com-no-minimo-32-chars
JWT_EXPIRATION=28800000

# Usuario administrador criado na primeira subida (apenas local/docker)
SEED_ENABLED=true
SEED_ADMIN_EMAIL=admin@sus.gov.br
SEED_ADMIN_SENHA=Admin@123
SEED_ADMIN_CPF=52998224725
